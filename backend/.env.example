# Server
NODE_ENV=development
PORT=4000

# Database
MONGODB_URI=mongodb://localhost:27017/novabank

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=change-me-in-production
# Set to true only when serving over HTTPS (TLS)
COOKIE_SECURE=false

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://frontend-taupe-chi-53.vercel.app

# SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# App
OTP_EXPIRY_MINUTES=5
SESSION_EXPIRY_HOURS=24
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
